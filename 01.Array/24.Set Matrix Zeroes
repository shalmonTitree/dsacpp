//bruteforce | TC: O(n × m × (n + m)), SC: O(1)

class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(matrix[i][j] == 0)
                {
                    for(int k = 0; k < m; k++)
                    {
                        if(matrix[i][k] != 0)
                        {
                            matrix[i][k] = -1e9;
                        }
                    }

                    for(int k = 0; k < n; k++)
                    {
                        if(matrix[k][j] != 0)
                        {
                            matrix[k][j] = -1e9;
                        }
                    }
                }

            }
        }

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(matrix[i][j] == -1e9)
                {
                    matrix[i][j] = 0;
                }
            }
        }


    }
};


better | TC: O(n × m), SC: O(n + m)

class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();
        vector<int>r(n,0);
        vector<int>c(m,0);
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(matrix[i][j] == 0)
                {
                    r[i] = 1;
                    c[j] = 1;

                }

            }
        }

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(r[i] == 1 || c[j] == 1)
                {
                    matrix[i][j] = 0;
                }
            }
        }


    }
};


//optimal
