//bruteforce


class Solution {
  public:
    vector<int> leaders(vector<int>& arr) {
        int n = arr.size();
        vector<int>ans;
        for(int i = 0; i < n; i++)
        {
            bool flag = false;
            for(int j = i + 1; j < n; j++)
            {
                if(arr[j] > arr[i])
                {
                    flag = true;
                    break;
                }
            }
            if(flag == false)
            {
                ans.push_back(arr[i]);
            }
        }
        return ans;
        
    }
};



//optimal | TC: O(n), SC: O(n)



class Solution {
  public:
    vector<int> leaders(vector<int>& arr) {
        
        int n = arr.size();
        vector<int>ans;
        ans.push_back(arr[n-1]);
        int maxi = arr[n - 1];
        for(int i = n - 2; i >= 0; i--)
        {
            if(arr[i] >= maxi)
            {
                maxi = arr[i];
                ans.push_back(maxi);
            }
        }
        reverse(ans.begin(),ans.end());
        return ans;
        
    }
};


