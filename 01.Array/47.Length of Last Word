class Solution {
public:
    int lengthOfLastWord(string s) {
        int n = s.size();
        int len = 0;
        int idx = n - 1;
       
        while(idx >= 0 && s[idx] == ' ')
        {
            idx--;
        }

        while(idx >= 0 && s[idx] != ' ')
        {
            len++;
            idx--;
        }
        return len;
    }
};
