//bruteforce | TC: O(n^2), SC: O(1) (excluding output vector)
 
class Solution {
  public:
    vector<int> findSubarray(vector<int>& arr) {
        int n = arr.size();
        long long ans = -1;
        int x = -1,y = -1;
        vector<int>val;
        for(int i = 0; i < n; i++)
        {
            long long sum = 0;
            for(int j = i; j < n; j++)
            {
                if(arr[j] < 0)
                {
                    break;
                }
                
                sum += arr[j];
                
                if(sum > ans)
                {
                    ans = sum;
                    x = i;
                    y = j;
                }
                else if(sum == ans)
                {
                    int v1 = j - i + 1;
                    int v2 = y - x + 1;
                    
                    if(v1 > v2)
                    {
                        x = i;
                        y = j;
                    }
                }
                
            }
        }
        
        if(ans == -1)
        {
            return {-1};
        }
        
        for(int i = x; i <= y; i++)
        {
            val.push_back(arr[i]);
        }
        
        return val;
    }
};



