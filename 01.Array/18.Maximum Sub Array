Time → O(n)
Space → O(1)

// User function template for C++
class Solution {
  public:
    vector<int> findSubarray(vector<int>& arr) {
        int n = arr.size();
        
        long long ans = -1;
        
        int beststart = -1,bestend = -1;
        int start = 0;
        
        vector<int>val;
        
        long long sum = 0;
        
        for(int i = 0; i < n; i++)
        {
           
           if(arr[i] < 0)
           {
               sum = 0;
               start = i + 1;
               continue;
           }
           
           sum += arr[i];
           
           if(sum > ans)
           {
               ans = sum;
               beststart = start;
               bestend = i;
           }
           else if(sum == ans)
           {
               int currentLength = i - start + 1;
               int bestLength = bestend - beststart + 1;
               
               if(currentLength > bestLength)
               {
                   beststart = start;
                   bestend = i;
               }
           }
           
        }
        
        if(ans == -1)
        {
            return {-1};
        }
        
        for(int i = beststart; i <= bestend; i++)
        {
            val.push_back(arr[i]);
        }
        
        return val;
    }
};
