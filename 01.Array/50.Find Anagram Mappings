using namespace std;

vector<int> solution(vector<int>& nums1, vector<int>& nums2) {
    int n = nums1.size();
    int m = nums2.size();
	
    unordered_map<int,vector<int>>mp;
    vector<int>ans;

    for(int i = 0; i < m; i++)
    {
    	mp[nums2[i]].push_back(i);
    }

    for(int i = 0; i < n; i++)
    {
        int val = nums1[i];
        ans.push_back(mp[val].back());
        mp[val].pop_back();
    }
    return ans;
    
}

