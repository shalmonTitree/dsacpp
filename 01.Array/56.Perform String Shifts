#include <iostream>
#include <vector>
#include <sstream>
#include <string>
using namespace std;

string solution(string s, vector<vector<int>>& shift) {
    // Write your code here

    int n = shift.size();
    int m = shift[0].size();

    string cpy = s;
    for(int i = 0; i < n; i++)
    {
        if(shift[i][0] == 0)
        {
			int cnt = shift[i][1];
            while(cnt--)
            {
                char f = cpy[0];
                cpy.erase(0,1);
                cpy += f;
            }
        }
        else
        {
			int cnt = shift[i][1];
            while(cnt--)
            {
                char l = cpy.back();
                cpy.pop_back();
                cpy = l + cpy;
            }
        }
    }
    return cpy;
}

int main() {

    string s;

    getline(cin, s);

    string shiftStr;

    getline(cin, shiftStr);

    vector<vector<int>> shift;

    vector<int> curr;

    string num = "";

    for(char c : shiftStr)
    {
        if(isdigit(c))
        {
            num += c;
        }
        else if(!num.empty())
        {
            curr.push_back(stoi(num));

            num = "";

            if(curr.size() == 2)
            {
                shift.push_back(curr);

                curr.clear();
            }
        }
    }

    cout << solution(s, shift);

    return 0;
}
