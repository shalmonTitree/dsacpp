//bruteforce
class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        int ans = 0;
        for(int i = 0; i < n; i++)
        {
            for(int j = i + 1; j < n; j++)
            {
                ans = max(ans,prices[j] - prices[i]);
            }
        }
        return ans;
    }
};

//optimal
class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        int ans = 0;
        int mini = prices[0];
        for(int i = 0; i < n; i++)
        {
            mini = min(mini,prices[i]);
            ans = max(ans,prices[i] - mini);
        }
        return ans;
    }
};
