//bruteforce
class Solution {
  public:
    long subarrayXor(vector<int> &arr, int k) {
        int n = arr.size();
       
        long long cnt = 0;
        for(int i = 0; i < n; i++)
        {
             int xr = 0;
            for(int j = i; j < n; j++)
            {
                xr ^= arr[j];
                if(xr == k)
                {
                    cnt++;
                }
            }
        }
        return cnt;
        
    }
};


//optimal | TC: O(n), SC: O(n)

class Solution {
  public:
    long subarrayXor(vector<int> &arr, int k) {
        int n = arr.size();
       
        long long cnt = 0;
        int xr = 0;
        unordered_map<int,int>mp;
        
        for(int i = 0; i < n; i++)
        {
            xr ^= arr[i];
            if(xr == k)
            {
                cnt++;
            }
            
            int x= xr ^ k;
            
            if(mp.find(x) != mp.end())
            {
                cnt += mp[x];
            }
            mp[xr]++;
        }
        return cnt;
        
    }
};
