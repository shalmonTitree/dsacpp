//bruteforce
class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        int cnt = 0;
        for(int i = 0; i < n; i++)
        {
            int sum = 0;
            for(int j = i; j < n; j++)
            {
                sum += nums[j];
                if(sum == k)
                {
                    cnt++;
                }
                
            }
        }
        return cnt;

    }
};
//optimal : using prefix sum 
class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int,int>mp;
        int sum = 0;
        mp[0] = 1;
        int ans = 0;

        for(auto it : nums)
        {
            sum += it;
            int target = sum - k;
            if(mp.find(target) != mp.end())
            {
                ans += mp[target];
            }
            mp[sum]++;

        }
        return ans;
    }
};
