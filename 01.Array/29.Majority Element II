//Bruteforce give tle
class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        vector<int>ans;
        set<int>st;
        int n = nums.size();
        for(int i = 0; i < n; i++)
        {
            int cnt = 0;
            for(int j = 0; j < n; j++)
            {
                if(nums[j] == nums[i])
                {
                    cnt++;
                }
            }
            if(cnt > floor(n/3))
            {
                st.insert(nums[i]);
            }
        }
        for(auto it : st)
        {
            ans.push_back(it);
        }
        return ans;
    }
};


//better using hashmap || TC: O(n log n), SC: O(n)


class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int n = nums.size();
        map<int,int>mp;
        vector<int>ans;
        for(auto it : nums)
        {
            mp[it]++;
        }
        for(auto it : mp)
        {
            if(it.second > (n/3))
            {
                ans.push_back(it.first);
            }
        }
        return ans;
    }
};

//optimal using moorees votiong algo

class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int n = nums.size();
        vector<int>ans;

        int cnt1 = 0;
        int cnt2 = 0;

        int ele1;
        int ele2;

        for(int i = 0; i < n; i++)
        {
            if(ele1 == nums[i])
            {
                cnt1++;
            }
            else if(ele2 == nums[i])
            {
                cnt2++;
            }
            else if(cnt1 == 0)
            {
                ele1 = nums[i];
                cnt1 = 1;
            }
            else if(cnt2 == 0)
            {
                ele2 = nums[i];
                cnt2 = 1;
            }
            else
            {
                cnt1--;
                cnt2--;
            }
        }
        cnt1 = 0;
        cnt2 = 0;

        for(int x : nums)
        {
            if(x == ele1)
                cnt1++;
            else if(x == ele2)
                cnt2++;
        }

       



        if(cnt1 > n/3)
            ans.push_back(ele1);

        if(cnt2 > n/3)
            ans.push_back(ele2);

        return ans;
    }
};
