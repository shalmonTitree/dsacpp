#include <iostream>
#include <bits/stdc++.h>
using namespace std;

bool solution(int n) {

    if(n == 0) return true;
     int cpy = n;
	string rev = "";
    map<int,int>mp;
    mp[0] = 0;
    mp[1] = 1;
    mp[6] = 9;
    mp[8] = 8;
    mp[9] = 6;

    while(cpy != 0)
    {
		int last = cpy % 10;
        if(last == 2 || last == 3 || last == 4 || last == 5 || last == 7)
        {
            return false;
        }
		rev += mp[last] + '0';
		cpy /= 10;
    }
   
    int val = stoi(rev);
    return val != n;
}

int main() {
    int n;
    cin >> n;
    bool result = solution(n);
    cout << (result ? "true" : "false") << endl;
    return 0;
}
