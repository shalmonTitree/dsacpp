TC: O(n), SC: O(n)

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
       
        int n = nums.size();
        vector<int>ans(n);
        int idx = 0;
        for(int i = 0; i < n; i++)
        {
            if(nums[i] > 0)
            {
                ans[idx] = nums[i];
                idx += 2;
            }
        }
        idx = 1;
        for(int i = 0; i < n; i++)
        {
            if(nums[i] < 0)
            {
                ans[idx] = nums[i];
                idx += 2;
            }
        }
        return ans;
    }
};
