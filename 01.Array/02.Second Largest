class Solution {
  public:
    int getSecondLargest(vector<int> &arr) {
       int n = arr.size();
        int largest = arr[0];
        int secondLargest = INT_MIN;
        for(int i = 1; i < n; i++)
        {
            if(arr[i] > largest)
            {
                largest = arr[i];
            }
        }
        
        for(int i = 0; i < n; i++)
        {
            if(arr[i] > secondLargest && arr[i] != largest)
            {
                secondLargest = arr[i];
            }
        }
        return secondLargest == INT_MIN ? -1 : secondLargest;
        
        
        
    }
};
