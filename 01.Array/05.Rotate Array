//bruteforce | Time Complexity: O(n×k), Space Complexity: O(1). 
class Solution {
public:
    void rotate(vector<int>& nums, int k) {
        int n = nums.size();
        while(k--)
        {
            int temp = nums[n - 1];
            for(int i = n - 2; i >= 0; i--)
            {
                nums[i+1] = nums[i];
            }
            nums[0] = temp;
        }
    }
};

//better
class Solution {
public:
    void rotate(vector<int>& nums, int k) {
        int n = nums.size();
        k = k % n;
        reverse(nums.begin(),nums.end());
        reverse(nums.begin(),nums.begin()+k);
        reverse(nums.begin()+k,nums.end());
        
    }
};
