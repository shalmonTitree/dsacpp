//bruteforce | Time Complexity: O(n2), Space Complexity: O(1).

class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int n = nums.size();
        int ans = 0;
        for(int i = 0; i < n; i++)
        {
            int cnt = 0;
            for(int j = i; j < n; j++)
            {
                if(nums[j] == 1)
                {
                    cnt++;
                    ans = max(ans,cnt);
                }
                else
                {
                    
                    break;
                }
            }
        }
        return ans;
    }
};

