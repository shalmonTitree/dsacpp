//Bruteforce
class Solution {
public:
    vector<int> replaceElements(vector<int>& arr) {
        int n = arr.size();
        vector<int>ans;
        for(int i = 0; i < n; i++)
        {
            int val = INT_MIN;
            for(int j = i + 1; j < n; j++)
            {
                val = max(val,arr[j]);
            }
            ans.push_back(val);
        }
        ans.pop_back();
        ans.push_back(-1);
        return ans;
    }
};

