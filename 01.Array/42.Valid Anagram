//bruteforce Time: O(n log n)
Space: O(1) or O(n)

class Solution {
public:
    bool isAnagram(string s, string t) {

        if(s.size() != t.size())
        {
            return false;
        }

        sort(s.begin(), s.end());
        sort(t.begin(), t.end());

        return s == t;
    }
};

//better Time: O(n)
Space: O(1) for fixed charset / O(k) generally

class Solution {
public:
    bool isAnagram(string s, string t) {

        if(s.size() != t.size())
        {
            return false;
        }

        unordered_map<char,int> mp;

        for(char ch : s)
        {
            mp[ch]++;
        }

        for(char ch : t)
        {
            mp[ch]--;
        }

        for(auto it : mp)
        {
            if(it.second != 0)
            {
                return false;
            }
        }

        return true;
    }
};

//optimal 
Time: O(n)
Space: O(1)

class Solution {
public:
    bool isAnagram(string s, string t) {

        if(s.size() != t.size())
        {
            return false;
        }

        int freq[26] = {0};

        for(char ch : s)
        {
            freq[ch - 'a']++;
        }

        for(char ch : t)
        {
            freq[ch - 'a']--;
        }

        for(int i = 0; i < 26; i++)
        {
            if(freq[i] != 0)
            {
                return false;
            }
        }

        return true;
    }
};
