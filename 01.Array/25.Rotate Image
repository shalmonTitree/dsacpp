//bruteforce | TC: O(n^2), SC: O(n^2)

class Solution {
public:
    void rotate(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();
        vector<vector<int>> ans(n, vector<int>(n));
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < n; j++)
            {
                ans[j][n-i-1] = matrix[i][j];
            }
        }
        matrix = ans;
    }
};


//better | TC: O(n^2), SC: O(1)

class Solution {
public:
    void rotate(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();
        
        for(int i = 0; i < n; i++)
        {
            for(int j = i+1; j < n; j++)
            {
                swap(matrix[i][j],matrix[j][i]);
            }
        }

        for(int i = 0; i < n; i++)
        {
            reverse(matrix[i].begin(),matrix[i].end());
        }
        
    }
};


