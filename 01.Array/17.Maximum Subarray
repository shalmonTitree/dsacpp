//bruteforce | TC: O(n^2), SC: O(1)
 
class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int n = nums.size();
        int ans = INT_MIN;
        for(int i = 0; i < n; i++)
        {
            int sum = 0;
            for(int j = i; j < n; j++)
            {
                sum += nums[j];
                if(sum > ans)
                {
                    ans = sum;
                }
            }
        }
        return ans;
    }
};


//optimal 
class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int n = nums.size();
        int ans = INT_MIN;

        int i = 0;
        int sum = 0;
        while(i < n)
        {
            sum += nums[i];
            if(sum > ans)
            {
                ans = sum;
            }

            if(sum <= 0)
            {
                sum = 0;
            }

            i++;
        }
        return ans;
    }
};
