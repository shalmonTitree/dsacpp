//bruteforce Time: Time: O(n²) Space: O(1)

class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {

        int n = nums.size();

        for(int i = 0; i < n; i++)
        {
            for(int j = i + 1; j < n; j++)
            {
                if(nums[i] == nums[j])
                {
                    return true;
                }
            }
        }

        return false;
    }
};

//better  Time: O(n log n) Space: O(1)
class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {

        sort(nums.begin(), nums.end());

        for(int i = 1; i < nums.size(); i++)
        {
            if(nums[i] == nums[i-1])
            {
                return true;
            }
        }

        return false;
    }
};

//optimal Time: O(n) Space: O(n)
class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {

        unordered_map<int,int> mp;

        for(auto it : nums)
        {
            mp[it]++;
        }

        for(auto it : mp)
        {
            if(it.second > 1)
            {
                return true;
            }
        }

        return false;
    }
};

//more optimal Time: O(n) average Space: O(n)
class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {

        unordered_set<int> st;

        for(auto it : nums)
        {
            if(st.find(it) != st.end())
            {
                return true;
            }

            st.insert(it);
        }

        return false;
    }
};
