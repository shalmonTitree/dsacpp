//bruteforce
int longestSubarrayWithSumK(vector<int> a, long long k) {
    int n = a.size();
    int len = 0;
    for(int i = 0; i < n; i++)
    {
        long long sum = 0;
        for(int j = i; j < n; j++)
        {
            sum += a[j];
            if(sum == k)
            {
                len = max(len,j - i + 1);
            }
        }
    }
    return len;
}
 
//optimal | Time Complexity: O(n), Space Complexity: O(1)
int longestSubarrayWithSumK(vector<int> a, long long k) {
    int n = a.size();
    int len = 0;
    int i = 0;
    int j = 0;
    long long sum = 0;
    while(j < n)
    {
        sum += a[j];

        while(sum > k)
            {
                sum -= a[i];
                i++;
            }

        if(sum == k)
        {
            len = max(len, j - i + 1);
        }
        
        j++;
    }
    return len;
}
