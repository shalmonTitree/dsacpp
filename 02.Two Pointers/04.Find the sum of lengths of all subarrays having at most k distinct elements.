#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"

void solve()
{
    int n, k;
    cin >> n >> k;

    int arr[n];

    for(int i = 0; i < n; i++)
        cin >> arr[i];

    // DS
    map<int,int> freq;
    int distinct = 0;

    // answer
    long long ans = 0;

    int tail = 0;
    int head = -1;

    while(tail < n)
    {
        // expand
        while(head + 1 < n &&
             (distinct < k || (distinct == k && freq[arr[head+1]] > 0)))
        {
            head++;

            freq[arr[head]]++;

            if(freq[arr[head]] == 1)
            {
                distinct++;
            }
        }

        // contribution
        long long len = head - tail + 1;

        ans += (len * (len + 1)) / 2;

        // shrink
        if(tail <= head)
        {
            freq[arr[tail]]--;

            if(freq[arr[tail]] == 0)
            {
                distinct--;
            }

            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }
    }

    cout << ans << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    solve();

    return 0;
}
