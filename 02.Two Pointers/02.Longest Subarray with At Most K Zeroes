#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define endl "\n"   

void solve() {
    int n,k;
    cin>>n>>k;
    int arr[n];
    for(int i = 0; i < n; i++) cin>>arr[i];

    //ds
    
    //ans varaible 
    int cnt0 = 0;
    int ans = 0;
    int tail = 0;
    int head = -1;

    while(tail < n)
    {
        //step 1 : keep eating as many as possible
        while(head + 1 < n && (cnt0 < k || (cnt0 == k && arr[head+1] == 1)))
        {
            head++;
            if(arr[head] == 0)
            {
                cnt0++;
            }
        }

        //step 2 : update answers
        ans = max(ans,head - tail + 1);


        //step 3 : move tail one step forward
        if(tail <= head)
        {
            if(arr[tail] == 0)
            {
                cnt0--;
            }
            tail++;
        }
        else
        {
            tail++;
            head = tail - 1;
        }

    }
    cout<<ans<<endl;

}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

   
        solve();
    

    return 0;
}

